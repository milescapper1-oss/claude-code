# Copy this file to .env and fill in your own values. Never commit .env.

# Anthropic API key, used by extraction/llm_extractor.py as a fallback
# extractor for pages where structured CSS selectors fail to find data.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used for LLM-based extraction. Defaults to claude-opus-4-8 if unset.
# For high-volume/low-cost extraction over many scraped pages, consider
# claude-haiku-4-5 instead.
ANTHROPIC_MODEL=claude-opus-4-8

# Seconds to wait between requests to any single source, to stay polite
# and avoid getting IP-blocked. Applies to all scrapers.
SCRAPER_REQUEST_DELAY_SECONDS=2
